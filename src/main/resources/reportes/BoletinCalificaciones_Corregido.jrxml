	<field name="semestre" class="java.lang.String"/>
	<field name="corte_evaluatico" class="java.lang.String"/>
	<field name="parcial" class="java.lang.String"/>
	<field name="acumulado" class="java.lang.Double"/>
	<field name="examen" class="java.lang.Double"/>
	<field name="nota" class="java.lang.Double"/>
	<sortField name="asignatura"/>
	<variable name="corte1" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{parcial} != null && $F{parcial}.trim().equalsIgnoreCase("I")) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="corte2" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{parcial} != null && $F{parcial}.trim().equalsIgnoreCase("II")) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="corte3" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{parcial} != null && $F{parcial}.trim().equalsIgnoreCase("III")) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="corte4" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{parcial} != null && $F{parcial}.trim().equalsIgnoreCase("IV")) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="corte5" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{parcial} != null && $F{parcial}.trim().equalsIgnoreCase("V")) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="corte6" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{parcial} != null && $F{parcial}.trim().equalsIgnoreCase("VI")) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="semestre1" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{semestre} != null && $F{semestre}.trim().equalsIgnoreCase("I")) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="semestre2" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(($F{semestre} != null && $F{semestre}.trim().equalsIgnoreCase("II")) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="promedioSem1" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[("I".equals($F{semestre}) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="promedioSem2" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup" calculation="Sum">
		<variableExpression><![CDATA[("II".equals($F{semestre}) ? $F{nota} : 0.0)]]></variableExpression>
	</variable>
	<variable name="promedioFinal" class="java.lang.Double" resetType="Group" resetGroup="AsignaturaGroup">
		<variableExpression><![CDATA[($V{semestre2} > 0.0) ? (($V{semestre1} + $V{semestre2}) / 2.0) : $V{semestre1}]]></variableExpression>
	</variable>
