<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BoletinCalificaciones" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="4b0d3c1a-8d7f-4e1f-9e4e-000000000002">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySql_data_Colegio"/>
	<parameter name="idMatricula" class="java.lang.Integer"/>
	<parameter name="LOGO_Colegio" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cedula" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="fechaNacimiento" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="tutor" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="director" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Lic. Eduado Solis"]]></defaultValueExpression>
	</parameter>
	<parameter name="observaciones" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
    m.idmatricula,
    e.cod_estudiante,
    CONCAT_WS(' ', p.nombre_completo, p.apellido_completo) AS estudiante,
    g.nombre AS grado,
    ne.nombre AS categoria_grado,
    sal.turno AS turno,
    sal.seccion AS seccion,
    cs.nombre_salon AS salon,
    m.anio_lectivo AS anio_escolar,
    pe.nombre_periodo AS periodo,
    a.nombre AS asignatura,
    CASE
        WHEN pe.numero_periodo BETWEEN 1 AND 3 THEN 'I'
        WHEN pe.numero_periodo BETWEEN 4 AND 6 THEN 'II'
        ELSE ''
    END AS semestre,
    pe.nombre_periodo AS corte_evaluatico,
    CASE pe.numero_periodo
        WHEN 1 THEN 'I'
        WHEN 2 THEN 'II'
        WHEN 3 THEN 'III'
        WHEN 4 THEN 'IV'
        WHEN 5 THEN 'V'
        WHEN 6 THEN 'VI'
        ELSE ''
    END AS parcial,
    COALESCE(CAST(c.acumulado AS DOUBLE), 0.0) AS acumulado,
    COALESCE(CAST(c.examen AS DOUBLE), 0.0) AS examen,
    COALESCE(CAST(c.nota_final AS DOUBLE), 0.0) AS nota
FROM matricula m
INNER JOIN estudiante e
    ON e.idpersona = m.idpersona
INNER JOIN persona p
    ON p.idpersona = e.idpersona
INNER JOIN salon sal
    ON sal.idSalon = m.idSalon
INNER JOIN grado g
    ON g.idGrado = sal.idGrado
INNER JOIN nivel_educativo ne
    ON ne.idnivel = g.idnivel
INNER JOIN catalogo_salon cs
    ON cs.idcatalogo_salon = sal.idcatalogo_salon
INNER JOIN plan_de_estudio pl
    ON pl.idGrado = g.idGrado
    AND pl.anio_lectivo = m.anio_lectivo
INNER JOIN detalle_plan_de_estudio dp
    ON dp.idPlan_de_estudio = pl.idPlan_de_estudio
INNER JOIN asignatura a
    ON a.idAsignatura = dp.idAsignatura
LEFT JOIN calificaciones c
    ON c.idmatricula = m.idmatricula
    AND c.iddetalle_plan_de_estudio = dp.iddetalle_plan_de_estudio
LEFT JOIN periodo_evaluativo pe
    ON pe.idperiodo_evaluativo = c.idperiodo_evaluativo
    AND pe.anio_escolar = m.anio_lectivo
WHERE m.idmatricula = $P{idMatricula}
ORDER BY a.nombre, pe.numero_periodo]]>
	</queryString>
	<field name="idmatricula" class="java.lang.Integer"/>
	<field name="cod_estudiante" class="java.lang.String"/>
	<field name="estudiante" class="java.lang.String"/>
	<field name="grado" class="java.lang.String"/>
